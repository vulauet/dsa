# Copy to ~/.config/mi-fitness-daily/credentials.env and `chmod 600` it.
# Only needed when the OS keyring isn't usable from cron/systemd (typical on
# headless Linux). On a desktop, `mi-fitness-bridge setup` is enough.

# `userId` and `passToken` cookies from a logged-in https://account.xiaomi.com session.
MI_FITNESS_USER_ID=
MI_FITNESS_PASS_TOKEN=

# Cloud region of your Xiaomi account: cn (mainland China) or e.g. sg, de, us, ru, i2.
MI_FITNESS_REGION=

# What "today" means for the sync window, e.g. Asia/Singapore, Europe/Berlin.
MI_FITNESS_TZ=UTC
